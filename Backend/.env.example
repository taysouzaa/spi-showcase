# ── Banco de dados (AWS RDS / Aurora PostgreSQL) ───────────────────────────────
DATABASE_URL="postgresql://usuario:senha@rds-endpoint.us-east-1.rds.amazonaws.com:5432/spi?sslmode=require"
DIRECT_URL="postgresql://usuario:senha@rds-endpoint.us-east-1.rds.amazonaws.com:5432/spi?sslmode=require"

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET="troque_por_um_valor_seguro_minimo_32_chars"
JWT_REFRESH_SECRET="outro_valor_seguro_para_refresh"
JWT_ACCESS_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ── Servidor ───────────────────────────────────────────────────────────────────
PORT=3333
NODE_ENV="production"
CORS_ORIGINS="https://seu-dominio.com.br"

# ── Admin seed (autenticação por e-mail + telefone — sem senha) ────────────────
ADMIN_EMAIL="admin@spi.com"
ADMIN_PHONE="11999999999"
ADMIN_NAME="Admin"

# ── Usuários iniciais (JSON) ───────────────────────────────────────────────────
# Formato: [{"name":"Nome","email":"email@ex.com","phone":"11999999999","marketplace":"amazon"}]
SEED_USERS_JSON=[]

# ── Google Drive ───────────────────────────────────────────────────────────────
GOOGLE_DRIVE_DEFAULT_FOLDER_ID=""
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_SERVICE_ACCOUNT_FILE="./credentials/service-account.json"
GOOGLE_DRIVE_REQUEST_TIMEOUT_MS=25000
GOOGLE_DRIVE_OPERATION_TIMEOUT_MS=30000

# ── AWS S3 ─────────────────────────────────────────────────────────────────────
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# ── Processamento de imagens ───────────────────────────────────────────────────
IMAGE_UPLOAD_DEDUP_TTL_MS=60000
IMAGE_MAX_CONCURRENCY=2
IMAGE_MAX_QUEUE_SIZE=100
IMAGE_QUEUE_WAIT_TIMEOUT_MS=15000
IMAGE_PROCESS_TIMEOUT_MS=45000
